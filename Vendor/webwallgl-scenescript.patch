+import SceneScriptWorker from "./scene-script-worker.ts?worker&inline";
+
+type ScriptKind = "text" | "object";
+type ScriptEvent = "init" | "update" | "applyUserProperties" | "applyGeneralSettings" | "cursorClick" | "cursorEnter" | "cursorLeave" | "cursorDown" | "cursorUp" | "cursorMove" | "mediaPropertiesChanged" | "mediaThumbnailChanged" | "mediaPlaybackChanged" | "mediaTimelineChanged" | "mediaStatusChanged" | "mediaLyricsChanged" | "animationEvent" | "resizeScreen" | "destroy";
+type RuntimeOptions = { generation: number; layers: () => any[]; onTimeout: (info: { script: string; event: string; milliseconds: number }) => void; onFailure?: (message: string) => void };
+type RecordEntry = { id: string; label: string; kind: ScriptKind; source: string; properties: any; opts: any; facade: any; result: any; destroyed: boolean; registered: boolean; lastUpdate: number; errors: number };
+type QueueItem = { type: "register" | "task"; record: RecordEntry; event: ScriptEvent | "initialization"; args?: any[]; raw?: boolean };
+
+const MAX_SOURCE_BYTES = 512 * 1024;
+const MAX_MESSAGE_BYTES = 1024 * 1024;
+const MAX_PENDING_EVENTS = 256;
+const MAX_PENDING_UPDATES = 1024;
+const MAX_UPDATES_PER_TICK = 64;
+const MAX_LAYER_SNAPSHOT_COUNT = 1600;
+const PATCH_KEYS = new Set([
+  "visible", "visibleSelf", "destroyed", "parentId", "hasChildren", "origin", "localOrigin", "scale", "localScale",
+  "angles", "localAngles", "color", "alpha", "brightness", "perspective", "solid", "rootmotion", "parallaxDepth", "text",
+  "textPointsize", "textFont", "textColor", "textBackgroundcolor", "textOpaquebackground", "textBackgroundbrightness",
+  "textPadding", "textHAlign", "textVAlign", "textLimitwidth", "textMaxwidth", "textLimitrows", "textMaxrows", "textLimituseellipsis",
+  "textAnchor", "textureAnimation", "spriteFrameIndex", "soundprops",
+]);
+const VECTOR_KEYS = new Set(["origin", "localOrigin", "scale", "localScale", "angles", "localAngles", "color", "textColor", "textBackgroundcolor", "parallaxDepth"]);
+const BOOL_KEYS = new Set(["visible", "visibleSelf", "destroyed", "hasChildren", "perspective", "solid", "rootmotion", "textOpaquebackground", "textLimitwidth", "textLimitrows", "textLimituseellipsis"]);
+const NUMBER_KEYS = new Set(["alpha", "brightness", "textPointsize", "textBackgroundbrightness", "textPadding", "textMaxwidth", "textMaxrows", "spriteFrameIndex"]);
+
+function safeValue(value: any, depth = 0, seen = new WeakSet<object>(), budget = { nodes: 0 }): any {
+  if (++budget.nodes > 20000 || depth > 20) return undefined;
+  if (value == null || typeof value === "boolean") return value;
+  if (typeof value === "string") return value.length > 65536 ? value.slice(0, 65536) : value;
+  if (typeof value === "number") return Number.isFinite(value) ? value : 0;
+  if (typeof value !== "object" || seen.has(value)) return undefined;
+  seen.add(value);
+  if (ArrayBuffer.isView(value)) return Array.from(value as any).slice(0, 4096).map((item: any) => Number.isFinite(Number(item)) ? Number(item) : 0);
+  if (Array.isArray(value)) return value.slice(0, 4096).map((item) => safeValue(item, depth + 1, seen, budget));
+  const out: Record<string, any> = Object.create(null);
+  for (const key of Object.keys(value).slice(0, 4096)) {
+    if (key === "__proto__" || key === "constructor" || key === "prototype") continue;
+    let next: any;
+    try { next = safeValue(value[key], depth + 1, seen, budget); } catch { continue; }
+    if (next !== undefined) out[key] = next;
+  }
+  return out;
+}
+
+function snapshotLayer(layer: any): any {
+  if (!layer || typeof layer !== "object") return null;
+  const out: Record<string, any> = Object.create(null);
+  const keys = [
+    "id", "name", "type", "destroyed", "parentId", "childIds", "hasChildren", "visible", "visibleSelf", "origin", "localOrigin",
+    "scale", "localScale", "angles", "localAngles", "size", "color", "alpha", "brightness", "perspective", "solid", "rootmotion",
+    "parallaxDepth", "text", "textPointsize", "textFont", "textColor", "textBackgroundcolor", "textOpaquebackground",
+    "textBackgroundbrightness", "textPadding", "textHAlign", "textVAlign", "textLimitwidth", "textMaxwidth", "textLimitrows",
+    "textMaxrows", "textLimituseellipsis", "textAnchor", "spriteFrameIndex", "spriteFrameCount", "spriteDuration", "image",
+    "textureName", "particle", "soundprops", "animations", "animationList", "animationLayers", "effects", "materialPasses",
+    "textureAnimation", "initialConfig", "attachment", "originalOrigin",
+  ];
+  for (const key of keys) {
+    try {
+      if (!(key in layer)) continue;
+      if (key === "effects" && Array.isArray(layer.effects)) {
+        out.effects = layer.effects.slice(0, 128).map((effect: any) => {
+          const copy = safeValue(effect);
+          if (copy && typeof copy === "object") delete copy.script;
+          return copy;
+        });
+      } else if (key === "textureAnimation") {
+        const state = layer.textureAnimation;
+        if (state && typeof state === "object") out.textureAnimation = safeValue({ frame: state.frame, playing: state.playing, rate: state.rate, restart: state.restart, phase: state.phase });
+      } else out[key] = safeValue(layer[key]);
+    } catch { /* omit getters that are not plain scene data */ }
+  }
+  return out;
+}
+
+function snapshotInput(view: any): any {
+  if (!view || typeof view !== "object") return Object.create(null);
+  const vector = (value: any) => value && typeof value === "object" ? { x: Number(value.x) || 0, y: Number(value.y) || 0, z: Number(value.z) || 0 } : { x: 0, y: 0, z: 0 };
+  return {
+    cursorWorldPosition: vector(view.cursorWorldPosition), cursorScreenPosition: vector(view.cursorScreenPosition),
+    cursorPosition: vector(view.cursorPosition), cursorPositionLast: vector(view.cursorPositionLast), cursorLeftDown: !!view.cursorLeftDown,
+  };
+}
+
+function audioSnapshot(views: any): Record<string, any> {
+  const out: Record<string, any> = Object.create(null);
+  if (views instanceof Map) for (const [size, buffers] of views) out[String(size)] = safeValue(buffers);
+  return out;
+}
+
+function eventFlags(source: string, name: string): boolean {
+  return new RegExp(`\\bfunction\\s*\\*?\\s*${name}\\s*\\(|\\b(?:var|let|const)\\s+${name}\\s*=`).test(source);
+}
+
+export class SceneScriptRuntime {
+  private readonly generation: number;
+  private readonly layers: () => any[];
+  private readonly onTimeout: RuntimeOptions["onTimeout"];
+  private readonly onFailure: (message: string) => void;
+  private worker: Worker | null = null;
+  private nextId = 1;
+  private readonly records = new Map<string, RecordEntry>();
+  private readonly controls: QueueItem[] = [];
+  private readonly updates = new Map<string, { record: RecordEntry; args: any[]; raw: boolean }>();
+  private updateCursor = 0;
+  private busy = false;
+  private active: { type: "register" | "task" | "tick" | "timer" | "dispose"; event?: string; id?: string; startedAt: number; watchdog?: ReturnType<typeof setTimeout> } | null = null;
+  private disabled = false;
+  private disposed = false;
+  private disposeRequested = false;
+  private flushQueued = false;
+  private readonly actionTimes = new Map<string, number[]>();
+
+  constructor(options: RuntimeOptions) {
+    this.generation = options.generation;
+    this.layers = options.layers;
+    this.onTimeout = options.onTimeout;
+    this.onFailure = options.onFailure || (() => {});
+  }
+
+  get isDisabled(): boolean { return this.disabled || this.disposed; }
+
+  createSandbox(kind: ScriptKind, script: string, properties: any, opts: any): any {
+    const source = typeof script === "string" ? script : "";
+    const id = `script-${this.nextId++}`;
+    const labelBase = String(opts?.sceneScriptLabel || opts?.layer?.name || (kind === "text" ? "text script" : "scene script"));
+    const label = `${labelBase}${opts?.sceneScriptField ? ` · ${String(opts.sceneScriptField).slice(0, 48)}` : ""}`.slice(0, 120);
+    const record: RecordEntry = { id, label, kind, source, properties: safeValue(properties || {}), opts: opts || {}, facade: null, result: undefined, destroyed: false, registered: false, lastUpdate: 0, errors: 0 };
+    this.records.set(id, record);
+    const facade = this.makeFacade(record);
+    record.facade = facade;
+    if (new TextEncoder().encode(source).byteLength > MAX_SOURCE_BYTES) {
+      facade.disabled = true;
+      opts?.onError?.(new Error("Script source is over the 512 KB worker limit."), "initialization");
+      return facade;
+    }
+    if (this.controls.length >= MAX_PENDING_EVENTS) {
+      facade.disabled = true;
+      opts?.onError?.(new Error("SceneScript pending event limit reached."), "initialization");
+      return facade;
+    }
+    this.controls.push({ type: "register", record, event: "initialization" });
+    this.flush();
+    return facade;
+  }
+
+  private makeFacade(record: RecordEntry): any {
+    const runtime = this;
+    const request = (event: ScriptEvent, args: any[] = [], raw = false): any => {
+      if (this.isDisabled || record.destroyed || record.facade?.disabled) return undefined;
+      if (event === "update") {
+        // Do not queue frame work behind a slow script. Updates collected before
+        // the worker starts are coalesced; once it is busy, this frame is skipped.
+        if (this.busy || this.controls.length > 0) return record.result;
+        if (this.updates.size < MAX_PENDING_UPDATES || this.updates.has(record.id)) this.updates.set(record.id, { record, args, raw });
+        this.scheduleFlush();
+        return record.result;
+      }
+      if (this.controls.length >= MAX_PENDING_EVENTS) {
+        record.errors++;
+        if (record.errors === 1) record.opts.onError?.(new Error("SceneScript event limit reached; event skipped."), event);
+        return undefined;
+      }
+      if (event === "destroy") record.destroyed = true;
+      this.controls.push({ type: "task", record, event, args, raw });
+      this.flush();
+      return undefined;
+    };
+    const entryDisabled: Record<string, boolean> = Object.create(null);
+    return {
+      id: record.id,
+      engine: {
+        runtime: 0, frametime: 1 / 60, timeOfDay: Number(record.opts.timeOfDay) || 0,
+        screenResolution: safeValue(record.opts.screenResolution || { x: 1920, y: 1080 }),
+        canvasSize: safeValue(record.opts.canvasSize || { width: 1920, height: 1080 }),
+      },
+      thisLayer: { id: record.opts.layer?.id ?? null, name: record.opts.layer?.name || "" },
+      scriptProperties: safeValue(record.properties || {}),
+      hasUpdate: eventFlags(record.source, "update"),
+      hasCursorHook: ["cursorClick", "cursorEnter", "cursorLeave", "cursorDown", "cursorUp", "cursorMove"].some((name) => eventFlags(record.source, name)),
+      hasMediaHook: ["mediaPropertiesChanged", "mediaThumbnailChanged", "mediaPlaybackChanged", "mediaTimelineChanged", "mediaStatusChanged", "mediaLyricsChanged"].some((name) => eventFlags(record.source, name)),
+      hasApplyHook: eventFlags(record.source, "applyUserProperties"),
+      hasDestroyHook: eventFlags(record.source, "destroy"),
+      hasGeneralSettingsHook: eventFlags(record.source, "applyGeneralSettings"),
+      hasAnimEventHook: eventFlags(record.source, "animationEvent"),
+      hasResizeHook: eventFlags(record.source, "resizeScreen"),
+      errCount: 0, errByEntry: Object.create(null), entryDisabled,
+      get disabled() { return runtime.isDisabled || !!entryDisabled.update || record.destroyed; },
+      set disabled(value: boolean) { if (value) entryDisabled.update = true; },
+      init: (value: any) => request("init", [value]),
+      applyUserProperties: (props: any) => request("applyUserProperties", [props || {}]),
+      applyGeneralSettings: (settings: any) => request("applyGeneralSettings", [settings || {}]),
+      destroy: () => request("destroy"),
+      callUpdate: (value: any) => request("update", [value]),
+      callUpdateRaw: (value: any) => request("update", [value], true),
+      callCursor: (name: string, event: any) => request(name as ScriptEvent, [event]),
+      callMedia: (name: string, event: any) => request(name as ScriptEvent, [event]),
+      callAnimationEvent: (event: any, value: any) => request("animationEvent", [event, value]),
+      callResize: (width: number, height: number) => request("resizeScreen", [width, height]),
+    };
+  }
+
+  dispose(): void {
+    if (this.disposed || this.disposeRequested) return;
